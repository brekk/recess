import type { Stream } from "Stream"

import { Data, Stream, Talkback } from "Stream"
import Wish from "Wish"



// recess types

export alias TimeSpanner a = a -> {}
export type TimerId = TimerId
// handle target segmentation

#iftarget js
setTimeout :: TimeSpanner {} -> Integer -> TimerId
export setTimeout = (cb, ms) => #- setTimeout(cb, ms) -#
clearTimeout :: TimeSpanner TimerId
export clearTimeout = (id) => #- clearTimeout(id) -#
#elseif llvm
setTimeout :: TimeSpanner {} -> Integer -> TimerId
export setTimeout = extern "__setTimeout__"
clearTimeout :: TimerId -> {}
export clearTimeout = extern "__clearTimeout__"
#endif
// CORE API

// delay first setTimeout
wait :: Integer -> TimeSpanner {} -> TimerId
export wait = (ms, cb) => setTimeout(cb, ms)
// delay first setInterval
withIntervalOnComplete :: ({} -> {}) -> Integer -> TimeSpanner a -> TimeSpanner {}
export withIntervalOnComplete = (cease, ms, onTick) => {
  stopped = false
  pending = false
  timer = TimerId

  start :: TimeSpanner {} -> {}
  start = (t) => {
    pending := true
    timer := setTimeout(t, ms)
  }

  stop :: {} -> a
  stop = () => {
    stopped := true
    if (pending) do {
      pending := false
      clearTimeout(timer)
    }
    return cease()
  }

  tick :: TimeSpanner {}
  tick = () => {
    pending := false
    onTick(stop)
    if (!stopped) do {
      start(tick)
    }
  }

  start(tick)
  return stop
}
export withInterval = withIntervalOnComplete(() => {})
export wishIntervalSource = (init, ms, cancel, cease, onTickReduce) => Wish.Wish(
  (_, good) => {
    stopped = false
    pending = false
    agg = init
    timer = TimerId

    start :: TimeSpanner {} -> {}
    start = (fn) => {
      pending := true
      timer := setTimeout(fn, ms)
    }

    stop :: {} -> a
    stop = () => {
      stopped := true
      if (pending) do {
        pending := false
        clearTimeout(timer)
      }
    }

    tick :: TimeSpanner {}
    tick = () => {
      pending := false
      agg := onTickReduce(stop, agg)
      if (!stopped) do {
        start(tick)
      } else {
        good(cease(agg))
      }
    }

    start(tick)
    return cancel
  },
)
export wishInterval = (ms, cancel, cease, onTickReduce, w) => chain(
  wishIntervalSource($, ms, cancel, cease, onTickReduce),
  w,
)
