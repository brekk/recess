import type { Stream } from "Stream"

import { Data, Stream, Talkback } from "Stream"
import Wish from "Wish"



// recess types

export alias TimeSpanner a = a -> {}
export type TimerId = TimerId
// handle target segmentation

#iftarget js
setTimeout :: TimeSpanner {} -> Integer -> TimerId
export setTimeout = (cb, ms) => #- setTimeout(cb, ms) -#
clearTimeout :: TimeSpanner TimerId
export clearTimeout = (id) => #- clearTimeout(id) -#
#elseif llvm
setTimeout :: TimeSpanner {} -> Integer -> TimerId
export setTimeout = extern "__setTimeout__"
clearTimeout :: TimerId -> {}
export clearTimeout = extern "__clearTimeout__"
#endif
// CORE API

waitFor = (ms, cb) => setTimeout(cb, ms)
// delay first setTimeout
wait :: Integer -> TimeSpanner {} -> TimerId
export wait = (ms, cb) => setTimeout(cb, ms)
// delay first setInterval
withIntervalOnComplete :: ({} -> b) -> Integer -> TimeSpanner a -> TimeSpanner {}
export withIntervalOnComplete = (cease, ms, onTick) => {
  stopped = false
  pending = false
  timer = TimerId

  start :: TimeSpanner {} -> {}
  start = (t) => {
    pending := true
    timer := setTimeout(t, ms)
  }

  stop :: {} -> a
  stop = () => {
    stopped := true
    if (pending) do {
      pending := false
      clearTimeout(timer)
    }
    return cease()
  }

  tick :: TimeSpanner {}
  tick = () => {
    pending := false
    onTick(stop)
    if (!stopped) do {
      start(tick)
    }
  }

  start(tick)
  return stop
}
export withInterval = withIntervalOnComplete(() => {})
alias RecessLoopConfig = { cancel :: {} -> {}, cease :: a -> b, init :: {} -> a }
alias TickReduce a = ({} -> a) -> a -> a
// withIntervalAsync :: Integer -> ({} -> {}) -> (a -> b) -> a -> TickReduce a -> Wish {} b
export withIntervalAsync = (ms, cancel, cease, init, onTickReduce) => Wish.Wish(
  (_, good) => {
    stopped = false
    pending = false
    agg = init
    timer = TimerId

    start :: TimeSpanner {} -> {}
    start = (fn) => {
      pending := true
      timer := setTimeout(fn, ms)
    }

    stop :: {} -> a
    stop = () => {
      stopped := true
      if (pending) do {
        pending := false
        clearTimeout(timer)
      }
      return good(cease(agg))
    }

    tick :: TimeSpanner {}
    tick = () => {
      pending := false
      agg := onTickReduce(stop, agg)
      if (!stopped) do {
        start(tick)
      }
    }

    start(tick)
    return cancel
  },
)
// delay first Stream-wrapped setInterval
withIntervalStream :: Integer -> Stream e Integer
export withIntervalStream = (ms) => Stream(
  (start, sink) => {
    if (start == 0) do {
      i = 0
      stop = withInterval(
        ms,
        (_) => {
          c = i
          i := i + 1
          sink(1, Data(c))
        },
      )
      sink(
        0,
        Talkback(
          (t) => if (t == 2) {
            stop()
          },
        ),
      )
    }
  },
)
